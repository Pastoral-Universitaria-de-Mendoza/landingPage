---
import Layout from "../layouts/Layout.astro";
import ProjectHero from "../components/ProjectHero.astro";
---

<Layout title="MANOS A LA OBRA" favicon="/images/logo-manos.png">
  <ProjectHero
    title="MANOS A LA OBRA"
    subtitle="Proyecto Universitario Solidario"
    description="Ponemos nuestros talentos y estudios al servicio de quienes más lo necesitan en Mendoza. Sumate como voluntario escribiéndonos por Instagram."
    ctaText="SUMARME EN @PU.MENDOZA"
    ctaHref="https://www.instagram.com/pu.mendoza/"
    logoSrc="/images/logo-manos.png"
    logoAlt="Manos a la Obra - Proyecto Universitario Solidario"
    logoWidth={471}
    logoHeight={527}
    logoClass="w-44 sm:w-56 h-auto object-contain"
  />
</Layout>
