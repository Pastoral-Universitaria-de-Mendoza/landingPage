---
import Layout from "../layouts/Layout.astro";
import ProjectHero from "../components/ProjectHero.astro";
---

<Layout title="MISIÓN EFFETÁ">
  <ProjectHero
    title="MISIÓN EFFETÁ"
    subtitle="Misión Universitaria"
    description="Salimos al encuentro de las comunidades de Mendoza para compartir la fe y la vida universitaria en misión. Consultá las próximas fechas en nuestras redes."
    ctaText="CONSULTAR EN @PU.MENDOZA"
    ctaHref="https://www.instagram.com/pu.mendoza/"
    logoSrc="/images/logo-effeta.png"
    logoAlt="Effetá - Misión Universitaria"
    logoWidth={310}
    logoHeight={426}
    logoClass="w-40 sm:w-52 h-auto object-contain"
  />
</Layout>
