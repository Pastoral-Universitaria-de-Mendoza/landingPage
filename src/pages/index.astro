---
import Layout from "../layouts/Layout.astro";
import Watermark from "../components/Watermark.astro";

const currentYear = new Date().getFullYear();
---

<Layout title="Sitio en Construcción" showNav={false} showFooter={false}>
  <section class="relative overflow-hidden h-dvh max-h-dvh flex flex-col justify-between items-center px-4 py-4 sm:px-6 sm:py-6">
    <Watermark />

    <!-- Header sutil superior -->
    <header class="relative z-10 w-full max-w-5xl flex items-center justify-between gap-4 shrink-0">
      <div class="flex items-center gap-2.5">
        <img
          src="/images/logo-pum.png"
          alt="Logo Pastoral Universitaria de Mendoza"
          width="424"
          height="466"
          class="w-10 sm:w-8 h-auto object-contain"
        />
        <span class="font-display text-xs sm:text-sm tracking-wider text-base-content/90 hidden sm:inline">
          PASTORAL UNIVERSITARIA DE MENDOZA
        </span>
      </div>

      <span class="badge badge-accent font-display text-secondary-content tracking-wider py-1.5 px-3 rounded-full border-0 text-[11px] sm:text-xs">
        EN CONSTRUCCIÓN
      </span>
    </header>

    <!-- Contenido central (100% viewport fit) -->
    <div class="relative z-10 max-w-2xl mx-auto w-full flex flex-col items-center text-center my-auto px-2">
      <img
        src="/images/logo-pum.png"
        alt="Logo Pastoral Universitaria de Mendoza"
        width="424"
        height="466"
        class="w-14 sm:w-16 md:w-20 h-auto object-contain mb-3 drop-shadow-md"
      />

      <h1 class="font-sans font-bold text-[clamp(1.5rem,3.8vw,2.5rem)] leading-[1.1] text-base-content text-balance">
        Estamos construyendo algo nuevo
      </h1>

      <div class="h-1 sm:h-1.5 w-16 sm:w-20 bg-secondary my-2.5 sm:my-3 rounded-full" aria-hidden="true"></div>

      <p class="font-sans text-base-content/90 text-[clamp(0.95rem,1.8vw,1.15rem)] leading-[1.3] max-w-xl text-pretty mb-3 sm:mb-4">
        Muy pronto vas a poder ver sobre nuestras actividades, proyectos, misiones y formas de participar.
      </p>

      <!-- Tarjeta Miércoles PUM compacta -->
      <div class="bg-base-200/90 border border-base-content/10 rounded-xl p-3 sm:p-4 max-w-md w-full text-center shadow-md backdrop-blur-xs mb-3 sm:mb-4">
        <p class="font-display text-secondary text-xs sm:text-sm tracking-wide uppercase">
          MIÉRCOLES PUM
        </p>
        <p class="font-sans font-bold text-base-content text-sm sm:text-base mt-0.5">
          Nos encontramos cada semana desde las 18 h
        </p>
        <p class="font-sans text-base-content/85 text-xs sm:text-sm mt-0.5">
          Parroquia Inmaculado Corazón de María (Rodríguez y Martín Zapata, Ciudad de Mendoza)
        </p>
        <div class="mt-2.5 flex justify-center">
          <a
            href="https://share.google/q3z5DHswtnGU8OYp5"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-xs sm:btn-sm text-secondary-content font-heading text-xs px-3 sm:px-4 py-1 rounded-lg border-0 inline-flex items-center gap-1.5 transition-transform hover:scale-105"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 shrink-0" aria-hidden="true">
              <path fill-rule="evenodd" d="m11.54 22.351.07.04.028.016a.76.76 0 0 0 .723 0l.028-.015.071-.041a16.975 16.975 0 0 0 1.144-.742 19.58 19.58 0 0 0 2.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 0 0-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 0 0 2.682 2.282 16.975 16.975 0 0 0 1.145.742ZM12 13.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd" />
            </svg>
            Ver Ubicación
          </a>
        </div>
      </div>

      <!-- Botones de contacto -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 w-full">
        <a
          href="https://www.instagram.com/pu.mendoza/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-sm sm:btn-md text-secondary-content font-sans font-bold px-4 sm:px-5 rounded-xl border-0 inline-flex items-center gap-2 transition-transform hover:scale-105 text-xs sm:text-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 212.3 212.3"
            class="w-4 h-4 fill-current shrink-0"
            aria-hidden="true"
          >
            <path d="M62.16.73c-11.29.53-19,2.34-25.74,4.98-6.98,2.72-12.89,6.36-18.77,12.27-5.89,5.91-9.51,11.83-12.2,18.82-2.61,6.76-4.38,14.47-4.88,25.77C.07,73.88-.04,77.49.01,106.31c.05,28.81.18,32.43.72,43.75.54,11.29,2.34,18.99,4.98,25.74,2.72,6.98,6.36,12.88,12.27,18.77,5.91,5.89,11.83,9.5,18.82,12.2,6.75,2.61,14.47,4.39,25.76,4.88,11.32.5,14.93.61,43.74.55,28.82-.05,32.43-.18,43.75-.72,11.29-.54,18.99-2.35,25.74-4.98,6.98-2.73,12.89-6.36,18.77-12.27,5.88-5.91,9.5-11.83,12.2-18.82,2.61-6.75,4.39-14.47,4.88-25.75.49-11.32.61-14.94.56-43.75-.05-28.81-.19-32.42-.72-43.74-.54-11.3-2.34-19-4.98-25.75-2.73-6.98-6.36-12.88-12.27-18.77-5.91-5.88-11.83-9.51-18.82-12.2-6.75-2.61-14.47-4.39-25.76-4.88C138.33.07,134.71-.04,105.9.01c-28.81.05-32.42.18-43.74.72M63.4,192.54c-10.34-.45-15.96-2.17-19.71-3.61-4.96-1.92-8.49-4.22-12.22-7.91-3.72-3.71-6.02-7.24-7.96-12.18-1.45-3.74-3.2-9.35-3.69-19.7-.53-11.18-.65-14.54-.7-42.87-.05-28.32.05-31.68.54-42.87.44-10.34,2.17-15.96,3.61-19.7,1.92-4.96,4.21-8.49,7.91-12.22,3.71-3.72,7.24-6.02,12.19-7.96,3.74-1.46,9.35-3.2,19.69-3.69,11.19-.53,14.54-.64,42.87-.7,28.33-.06,31.69.04,42.88.54,10.34.45,15.96,2.16,19.7,3.61,4.96,1.92,8.5,4.2,12.22,7.91,3.72,3.71,6.03,7.23,7.96,12.19,1.46,3.73,3.2,9.35,3.69,19.68.53,11.19.65,14.55.7,42.87.05,28.33-.05,31.69-.54,42.87-.45,10.34-2.17,15.97-3.61,19.71-1.92,4.95-4.21,8.49-7.92,12.21-3.71,3.71-7.23,6.02-12.19,7.96-3.73,1.46-9.35,3.2-19.68,3.69-11.19.53-14.54.65-42.88.7-28.32.05-31.68-.05-42.87-.54M149.9,49.39c.01,7.03,5.73,12.72,12.75,12.7,7.03-.01,12.72-5.72,12.71-12.75-.01-7.03-5.73-12.72-12.76-12.71-7.03.01-12.72,5.73-12.71,12.75M51.62,106.21c.06,30.09,24.5,54.43,54.58,54.37,30.09-.06,54.44-24.49,54.38-54.58-.06-30.08-24.5-54.43-54.59-54.38-30.08.06-54.43,24.5-54.37,54.59M70.73,106.17c-.03-19.53,15.77-35.4,35.3-35.43,19.53-.04,35.4,15.76,35.44,35.3.04,19.53-15.77,35.4-35.3,35.43-19.53.04-35.4-15.77-35.43-35.3" />
          </svg>
          @pu.mendoza
        </a>
        <a
          href="mailto:pastoraluniversitariamza@gmail.com"
          class="btn btn-outline btn-sm sm:btn-md border-base-content/25 text-base-content hover:bg-base-content/10 font-sans font-bold px-4 sm:px-5 rounded-xl inline-flex items-center gap-2 transition-transform hover:scale-105 text-xs sm:text-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-4 h-4 shrink-0"
            aria-hidden="true"
          >
            <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
            <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
          </svg>
          Contacto
        </a>
      </div>
    </div>

    <!-- Footer sutil en una sola línea -->
    <footer class="relative z-10 w-full max-w-5xl flex flex-wrap items-center justify-between gap-3 text-xs text-base-content/75 shrink-0 pt-2 border-t border-base-content/10">
      <div class="flex items-center gap-3">
        <a href="mailto:pastoraluniversitariamza@gmail.com" class="hover:text-secondary transition-colors">
          pastoraluniversitariamza@gmail.com
        </a>
        <span aria-hidden="true">•</span>
        <a
          href="https://www.instagram.com/pu.mendoza/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-secondary transition-colors"
        >
          @pu.mendoza
        </a>
      </div>
      <span>{currentYear} © Pastoral Universitaria de Mendoza</span>
    </footer>
  </section>
</Layout>
