---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const isHome = currentPath === "/";

const navItems = [
  { label: "PORTADA", href: "/" },
  { label: "MANOS A LA OBRA", href: "/manos-a-la-obra" },
  { label: "MISIÓN EFFETÁ", href: "/mision-effeta" },
  { label: "ÁREAS", href: "/areas" },
  { label: "TIENDA PUM", href: "/tienda-pum" },
];
---

<header class="bg-base-100/95 backdrop-blur-xs text-base-content sticky top-0 z-50 border-b border-base-content/10">
  <div class="navbar max-w-7xl mx-auto min-h-14 md:min-h-18 px-4 sm:px-8">
    <div class="navbar-start">
      <a
        id="navbar-brand"
        href="/"
        class:list={[
          "flex items-center gap-2.5 md:gap-3.5 group transition-all duration-300 ease-out",
          isHome
            ? "opacity-0 -translate-y-2 pointer-events-none"
            : "opacity-100 translate-y-0 animate-fade-in-scale",
        ]}
        aria-label="Pastoral Universitaria de Mendoza - Inicio"
      >
        <img
          src="/images/logo-pum.png"
          alt=""
          width="424"
          height="466"
          class="w-9 sm:w-7 md:w-12 lg:w-14 h-auto object-contain transition-transform group-hover:scale-105"
        />
        <span class="font-display text-sm md:text-xl lg:text-2xl tracking-wider md:tracking-widest text-base-content hidden sm:inline">
          LA PUM
        </span>
      </a>
    </div>

    <nav class="navbar-end w-full justify-end" aria-label="Navegación principal">
      <ul class="menu menu-horizontal hidden md:flex gap-1 px-1 py-0 text-[15px]">
        {navItems.map((item) => {
          const active = currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "rounded-none bg-transparent! px-3.5 py-2 text-base-content hover:text-secondary transition-colors",
                  active
                    ? "font-bold border-b-2 border-secondary text-base-content"
                    : "font-normal text-base-content/85",
                ]}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <details class="dropdown dropdown-end md:hidden" id="mobile-menu">
        <summary class="btn btn-ghost btn-sm px-2.5 text-lg" aria-label="Abrir menú">☰</summary>
        <ul class="dropdown-content menu bg-base-200 rounded-box z-50 w-60 p-2 mt-2 shadow-xl border border-base-content/10">
          {navItems.map((item) => {
            const active = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    active ? "font-bold text-secondary" : "font-normal text-base-content",
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  const brand = document.getElementById("navbar-brand");
  const hero = document.getElementById("hero-section");

  if (brand && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          brand.classList.add("opacity-0", "-translate-y-2", "pointer-events-none");
          brand.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
        } else {
          brand.classList.remove("opacity-0", "-translate-y-2", "pointer-events-none");
          brand.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
        }
      },
      {
        rootMargin: "-30% 0px 0px 0px",
      }
    );

    observer.observe(hero);
  }

  const dropdown = document.getElementById("mobile-menu") as HTMLDetailsElement | null;
  if (dropdown) {
    // Cerrar al hacer scroll
    window.addEventListener(
      "scroll",
      () => {
        if (dropdown.hasAttribute("open")) {
          dropdown.removeAttribute("open");
        }
      },
      { passive: true }
    );

    // Cerrar al clickear en cualquier apartado fuera del botón de apertura
    document.addEventListener("click", (event) => {
      if (!dropdown.hasAttribute("open")) return;
      const target = event.target as Node;
      const summary = dropdown.querySelector("summary");
      if (summary && !summary.contains(target)) {
        dropdown.removeAttribute("open");
      }
    });
  }
</script>
