---
interface Props {
  nombre: string;
  descripcion: string;
  carreras?: string[];
  whatsappUrl?: string;
  slug?: string;
  class?: string;
}

const {
  nombre,
  descripcion,
  carreras = [],
  whatsappUrl,
  slug,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "card bg-base-200/80 border border-base-content/10 rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-secondary/40",
    className,
  ]}
>
  <div class="card-body p-0 gap-3">
    <h2 class="card-title font-display text-secondary text-2xl sm:text-3xl">
      {slug ? (
        <a href={`/areas/${slug}`} class="hover:underline focus:outline-hidden">
          {nombre}
        </a>
      ) : (
        nombre
      )}
    </h2>
    <p class="font-sans text-base-content/90 text-base sm:text-lg leading-relaxed text-pretty">
      {descripcion}
    </p>
  </div>

  <div class="mt-5 flex flex-col gap-3.5">
    {carreras.length > 0 && (
      <div class="pt-3.5 border-t border-base-content/10">
        <p class="text-[11px] uppercase font-heading text-secondary tracking-wider mb-1.5">
          Carreras y disciplinas afines:
        </p>
        <div class="flex flex-wrap gap-1">
          {carreras.map((carrera) => (
            <span class="badge badge-neutral badge-sm text-[11px] rounded-md border-0 text-base-content/90">
              {carrera}
            </span>
          ))}
          <span class="badge badge-neutral badge-sm text-[11px] rounded-md border-0 text-base-content/90">
            Y más...
          </span>
        </div>
      </div>
    )}

    <div class="pt-3.5 border-t border-base-content/10 flex flex-col sm:flex-row gap-2.5">
      {slug && (
        <a
          href={`/areas/${slug}`}
          class="btn btn-secondary text-secondary-content flex-1 rounded-2xl font-heading text-sm sm:text-base border-0 shadow-sm inline-flex items-center justify-center gap-1.5 transition-transform hover:scale-[1.02] active:scale-95"
        >
          Conocer el área
          <span aria-hidden="true">→</span>
        </a>
      )}

      {whatsappUrl && (
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "btn btn-neutral rounded-2xl font-heading text-xs sm:text-sm border-0 shadow-sm inline-flex items-center justify-center gap-2 transition-transform hover:scale-[1.02] active:scale-95 text-base-content/90",
            slug ? "sm:w-auto px-4" : "w-full",
          ]}
          title={`Unirme al grupo de WhatsApp de ${nombre}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0 text-secondary" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.41 1.56 1.56 2.41 3.63 2.41 5.83s-.85 4.26-2.41 5.82c-1.55 1.55-3.62 2.41-5.82 2.41-1.5 0-2.97-.39-4.26-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.37c0-2.2.86-4.27 2.41-5.83 1.56-1.55 3.63-2.41 5.82-2.41m-3.5 4.21c-.19 0-.5.07-.76.35-.26.29-1 1-1 2.44s1.02 2.83 1.16 3.02c.14.19 2.01 3.07 4.87 4.31.68.29 1.21.47 1.63.6.68.22 1.3.19 1.79.12.55-.08 1.69-.69 1.93-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.33s-1.69-.83-1.95-.93c-.26-.09-.45-.14-.64.14-.19.29-.74.93-.91 1.12-.17.19-.34.21-.63.07-.29-.14-1.22-.45-2.32-1.43-.86-.77-1.44-1.72-1.61-2.01-.17-.29-.02-.45.13-.59.13-.13.29-.34.43-.51.14-.17.19-.29.29-.48.09-.19.05-.36-.02-.5-.07-.14-.64-1.55-.88-2.12-.23-.56-.47-.48-.64-.49-.17-.01-.36-.01-.55-.01" />
          </svg>
          WhatsApp
        </a>
      )}
    </div>
  </div>
</div>
