---
interface Props {
  nombre: string;
  descripcion: string;
  carreras?: string[];
  whatsappUrl?: string;
  slug?: string;
  class?: string;
}

const {
  nombre,
  descripcion,
  carreras = [],
  whatsappUrl,
  slug,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "group card bg-base-200/80 border border-base-content/10 rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-secondary/40",
    className,
  ]}
>
  <div class="card-body p-0 gap-3">
    <!-- Icono: encima del título en celular (opción 1), al costado en desktop (opción 2) -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-3">
      {slug === "sociales" && (
        <div class="w-12 h-12 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:bg-secondary group-hover:text-secondary-content">
          <!-- Balanza (Sociales) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
            <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
            <path d="M7 21h10" />
            <path d="M12 3v18" />
            <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
          </svg>
        </div>
      )}

      {slug === "ingenio" && (
        <div class="w-12 h-12 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:bg-secondary group-hover:text-secondary-content">
          <!-- Engranaje mecánico (Ingenio) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1Z" />
          </svg>
        </div>
      )}

      {slug === "creativa" && (
        <div class="w-12 h-12 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:bg-secondary group-hover:text-secondary-content">
          <!-- Paleta de pintura (Creativa) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
            <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
            <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
            <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
          </svg>
        </div>
      )}

      {slug === "salud" && (
        <div class="w-12 h-12 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:bg-secondary group-hover:text-secondary-content">
          <!-- Estetoscopio (Salud) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3" />
            <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4" />
            <circle cx="20" cy="10" r="2" />
          </svg>
        </div>
      )}

      {slug === "psico-educacion" && (
        <div class="w-12 h-12 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:bg-secondary group-hover:text-secondary-content">
          <!-- Libro Abierto (Psico-educación) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
          </svg>
        </div>
      )}

      {slug === "jovenes-profesionales" && (
        <div class="w-12 h-12 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:bg-secondary group-hover:text-secondary-content">
          <!-- Portafolios / Maletín (Jóvenes Profesionales) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            <rect width="20" height="14" x="2" y="6" rx="2" />
          </svg>
        </div>
      )}

      <h3 class="card-title font-display text-secondary text-2xl sm:text-3xl">
        {slug ? (
          <a href={`/areas/${slug}`} class="hover:underline focus:outline-hidden">
            {nombre}
          </a>
        ) : (
          nombre
        )}
      </h3>
    </div>

    <p class="font-sans text-base-content/90 text-base sm:text-lg leading-relaxed text-pretty">
      {descripcion}
    </p>
  </div>

  <div class="mt-5 flex flex-col gap-3.5">
    {carreras.length > 0 && (
      <div class="pt-3.5 border-t border-base-content/10">
        <p class="text-[11px] uppercase font-heading text-secondary tracking-wider mb-1.5">
          Carreras y disciplinas afines:
        </p>
        <div class="flex flex-wrap gap-1">
          {carreras.map((carrera) => (
            <span class="badge badge-neutral badge-sm text-[11px] rounded-md border-0 text-base-content/90">
              {carrera}
            </span>
          ))}
          <span class="badge badge-neutral badge-sm text-[11px] rounded-md border-0 text-base-content/90">
            Y más...
          </span>
        </div>
      </div>
    )}

    <div class="pt-3.5 border-t border-base-content/10 flex flex-col sm:flex-row gap-2.5">
      {slug && (
        <a
          href={`/areas/${slug}`}
          class="btn btn-secondary text-secondary-content flex-1 h-12 min-h-12 rounded-2xl font-heading text-sm sm:text-base border-0 shadow-sm inline-flex items-center justify-center gap-1.5 transition-transform hover:scale-[1.02] active:scale-95"
        >
          Conocer el área
          <span aria-hidden="true">→</span>
        </a>
      )}

      {whatsappUrl && (
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "btn btn-neutral h-12 min-h-12 rounded-2xl font-heading text-xs sm:text-sm border-0 shadow-sm inline-flex items-center justify-center gap-2 transition-transform hover:scale-[1.02] active:scale-95 text-base-content/90",
            slug ? "sm:w-auto px-4" : "w-full",
          ]}
          title={`Unirme al grupo de WhatsApp de ${nombre}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0 text-secondary" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.41 1.56 1.56 2.41 3.63 2.41 5.83s-.85 4.26-2.41 5.82c-1.55 1.55-3.62 2.41-5.82 2.41-1.5 0-2.97-.39-4.26-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.37c0-2.2.86-4.27 2.41-5.83 1.56-1.55 3.63-2.41 5.82-2.41m-3.5 4.21c-.19 0-.5.07-.76.35-.26.29-1 1-1 2.44s1.02 2.83 1.16 3.02c.14.19 2.01 3.07 4.87 4.31.68.29 1.21.47 1.63.6.68.22 1.3.19 1.79.12.55-.08 1.69-.69 1.93-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.33s-1.69-.83-1.95-.93c-.26-.09-.45-.14-.64.14-.19.29-.74.93-.91 1.12-.17.19-.34.21-.63.07-.29-.14-1.22-.45-2.32-1.43-.86-.77-1.44-1.72-1.61-2.01-.17-.29-.02-.45.13-.59.13-.13.29-.34.43-.51.14-.17.19-.29.29-.48.09-.19.05-.36-.02-.5-.07-.14-.64-1.55-.88-2.12-.23-.56-.47-.48-.64-.49-.17-.01-.36-.01-.55-.01" />
          </svg>
          WhatsApp
        </a>
      )}
    </div>
  </div>
</div>
