---
import Watermark from "../Watermark.astro";
import ContactCard from "../ContactCard.astro";
---

<section class="bg-secondary text-secondary-content relative overflow-hidden min-h-[calc(100dvh-3.5rem)] lg:h-[calc(100dvh-3.5rem)] flex flex-col justify-center py-12 lg:py-0 px-6 sm:px-10">
  <Watermark />
  <div class="relative z-10 max-w-7xl mx-auto w-full flex flex-col lg:flex-row lg:items-center justify-between gap-10">
    <div class="max-w-lg">
      <h2 class="font-display text-secondary-content text-[clamp(2.2rem,5vw,4.2rem)] leading-none">
        CONTACTO
      </h2>
      <p class="font-sans font-bold text-secondary-content opacity-90 text-lg sm:text-xl mt-4 text-pretty max-w-[38ch]">
        Escribinos o seguí las actividades de la semana en nuestras redes.
      </p>
    </div>

    <div class="flex flex-col gap-4 sm:gap-5 lg:shrink-0 w-full sm:w-auto">
      <ContactCard
        href="mailto:pastoraluniversitaria.mza@gmail.com"
        type="email"
        text="pastoraluniversitaria.mza@gmail.com"
      />
      <ContactCard
        href="https://www.instagram.com/pu.mendoza/"
        type="instagram"
        text="@pu.mendoza"
        external={true}
      />
    </div>
  </div>
</section>
