---
import Watermark from "../Watermark.astro";
import ProjectCard from "../ProjectCard.astro";

const currentYear = new Date().getFullYear();

const objetivos = [
  {
    titulo: "Animar y acompañar la fe",
    descripcion: "Promover la vivencia espiritual y comunitaria de los universitarios católicos.",
  },
  {
    titulo: "Canal de solidaridad",
    descripcion: "Servir de puente de servicio y compromiso solidario entre la universidad y la sociedad.",
  },
  {
    titulo: "Diálogo Fe y Cultura",
    descripcion: "Fomentar el encuentro dinámico entre el saber académico, la cultura contemporánea y la fe cristiana.",
  },
];
---

<section class="bg-secondary text-secondary-content relative overflow-hidden min-h-[calc(100dvh-3.5rem)] flex flex-col justify-center py-16 px-6 sm:px-10">
  <Watermark />
  <div class="relative z-10 max-w-7xl mx-auto w-full flex flex-col gap-10 lg:gap-12">
    <!-- Presentación e Identidad -->
    <div class="max-w-3xl">
      <span class="font-display text-sm sm:text-base tracking-widest uppercase opacity-85">
        Arquidiócesis de Mendoza · {currentYear - 2005} Años de Trayectoria (2005 - {currentYear})
      </span>
      <h2 class="font-heading text-secondary-content text-[clamp(2.1rem,4.5vw,3.6rem)] leading-[0.98] mt-2">
        La Pastoral Universitaria de Mendoza
      </h2>
      <p class="font-sans text-secondary-content text-[clamp(1.05rem,1.8vw,1.35rem)] leading-relaxed mt-4 text-pretty font-bold opacity-95">
        Ofrecemos a los integrantes de la comunidad universitaria la oportunidad de integrar su vida académica y profesional con la fe, coordinando el estudio y las actividades con principios religiosos y morales.
      </p>
    </div>

    <!-- 3 Objetivos -->
    <div>
      <h3 class="font-display text-xs sm:text-sm tracking-wider uppercase opacity-80 mb-4">
        Nuestros Objetivos
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        {objetivos.map((obj, i) => (
          <div class="bg-secondary-content/10 border border-secondary-content/20 rounded-2xl p-5 sm:p-6 backdrop-blur-xs flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:bg-secondary-content/15">
            <div>
              <span class="font-display text-lg opacity-60">0{i + 1}</span>
              <h4 class="font-heading text-lg sm:text-xl text-secondary-content mt-1 leading-snug">
                {obj.titulo}
              </h4>
              <p class="font-sans text-sm sm:text-base text-secondary-content/90 mt-2 leading-relaxed">
                {obj.descripcion}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Proyectos Principales -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 pt-6 border-t border-secondary-content/20">
      <div>
        <span class="block font-display text-secondary-content text-[clamp(2rem,4vw,3.4rem)] leading-[0.9]">
          NUESTROS
        </span>
        <span class="block font-display text-secondary-content text-[clamp(1.8rem,3.6vw,3rem)] leading-[0.9]">
          PROYECTOS
        </span>
      </div>

      <div class="grid grid-cols-2 gap-4 sm:gap-6 max-w-lg w-full lg:w-auto">
        <ProjectCard
          href="/mision-effeta"
          imgSrc="/images/logo-effeta.png"
          imgAlt="Effetá - Misión Universitaria"
          imgWidth={310}
          imgHeight={426}
          imgClass="w-24 sm:w-32 md:w-36 h-auto object-contain"
        />

        <ProjectCard
          href="/manos-a-la-obra"
          imgSrc="/images/logo-manos.png"
          imgAlt="Manos a la Obra - Proyecto Universitario Solidario"
          imgWidth={471}
          imgHeight={527}
          imgClass="w-28 sm:w-36 md:w-40 h-auto object-contain"
        />
      </div>
    </div>
  </div>
</section>
