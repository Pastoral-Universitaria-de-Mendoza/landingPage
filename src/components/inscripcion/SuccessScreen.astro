---
import WhatsappIcon from "./WhatsappIcon.astro";
import { MO_CALENDAR_URL, SALUD_CALENDAR_URL } from "../../data/inscripcion-mo";

interface Props {
  whatsappNumber: string;
  whatsappDisplay: string;
}

const { whatsappNumber, whatsappDisplay } = Astro.props;
---

<div id="success-screen" class="hidden card bg-base-200/80 border-2 border-secondary/50 text-base-content rounded-3xl p-6 sm:p-10 shadow-2xl space-y-6">
  <!-- Encabezado y fecha -->
  <div class="text-center space-y-3 max-w-xl mx-auto">
    <span class="badge badge-secondary font-heading text-xs px-3 py-1 rounded-md">
      26 al 30 de diciembre · Carrodilla
    </span>
    <h2 class="font-display text-3xl sm:text-4xl text-secondary">¡INSCRIPCIÓN REGISTRADA!</h2>
    <p class="font-sans text-sm sm:text-base text-base-content/90 leading-relaxed">
      ¡Gracias por sumarte a esta comunidad que se pone en camino! Nos vemos muy pronto en Carrodilla. 🎒✨
    </p>
    <div class="pt-2">
      <a
        href={MO_CALENDAR_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary text-secondary-content rounded-2xl font-heading px-6 py-3 h-auto shadow-lg border-2 border-secondary-content/25 inline-flex items-center gap-2 transition-all duration-200 hover:scale-[1.03] hover:shadow-xl active:scale-95 motion-reduce:transition-none motion-reduce:transform-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-5 h-5 shrink-0 animate-bounce motion-reduce:animate-none"
          aria-hidden="true"
        >
          <path d="M8 2v4" />
          <path d="M16 2v4" />
          <rect width="18" height="18" x="3" y="4" rx="2" />
          <path d="M3 10h18" />
        </svg>
        Agendar fecha en Google Calendar
      </a>
    </div>
  </div>

  <!-- Próximos pasos unificados -->
  <div class="bg-base-100/80 border border-base-content/15 rounded-2xl divide-y divide-base-content/10 max-w-2xl mx-auto">
    <div id="zona-whatsapp-box" class="hidden p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="space-y-0.5">
        <p class="font-heading text-sm sm:text-base text-base-content">
          Sumate al WhatsApp de tu zona
        </p>
        <p id="zona-whatsapp-label" class="font-sans text-xs text-base-content/75"></p>
      </div>
      <a
        id="btn-whatsapp-zona"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sm bg-[#075e54] hover:bg-[#054c44] text-white border-0 rounded-xl font-heading inline-flex items-center gap-2 shrink-0 self-start sm:self-center"
      >
        <WhatsappIcon class="w-4 h-4 shrink-0 text-[#25D366]" />
        Unirme al grupo
      </a>
    </div>

    <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="space-y-0.5">
        <p class="font-heading text-sm sm:text-base text-base-content">
          Validá tu pago
        </p>
        <p class="font-sans text-xs text-base-content/75">
          Enviá tu comprobante por WhatsApp al <strong>{whatsappDisplay}</strong>.
        </p>
      </div>
      <a
        id="btn-whatsapp-comprobante"
        href={`https://wa.me/${whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sm bg-[#075e54] hover:bg-[#054c44] text-white border-0 rounded-xl font-heading inline-flex items-center gap-2 shrink-0 self-start sm:self-center"
      >
        <WhatsappIcon class="w-4 h-4 shrink-0 text-[#25D366]" />
        Enviar comprobante
      </a>
    </div>

    <div id="salud-convivencia-success" role="status" class="hidden p-4 sm:p-5 bg-secondary/10 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="space-y-0.5">
        <p class="font-heading text-sm sm:text-base text-secondary">
          🩺 Convivencia de Salud (RCP y primeros auxilios)
        </p>
        <p class="font-sans text-xs text-base-content/85">
          Domingo 20/12 · 11 a 20 h · Dr. Alfredo Metraux 2930, Ciudad. ¡No hace falta experiencia previa!
        </p>
      </div>
      <a
        href={SALUD_CALENDAR_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary btn-sm text-secondary-content rounded-xl font-heading shrink-0 self-start sm:self-center"
      >
        Agendar
      </a>
    </div>
  </div>

  <!-- Frase de cierre -->
  <blockquote class="max-w-xl mx-auto border-l-4 border-secondary pl-4 py-1 text-left">
    <p class="font-heading text-sm sm:text-base text-base-content/90 leading-relaxed">
      «Nadie puede pelear la vida aisladamente. Se necesita una comunidad que nos sostenga, que nos ayude y en la que nos ayudemos unos a otros a mirar hacia adelante».
    </p>
  </blockquote>

  <!-- Acciones secundarias -->
  <div class="pt-1 flex flex-wrap justify-center gap-3">
    <a href="/manos-a-la-obra" class="btn btn-outline border-base-content/30 text-base-content hover:border-secondary hover:text-secondary btn-sm sm:btn-md rounded-2xl font-heading">
      Volver a Manos a la Obra
    </a>
  </div>
</div>
