---
interface Props {
  stepTitles: string[];
  devMode: boolean;
}

const { stepTitles, devMode } = Astro.props;
---

<ul class="steps steps-horizontal w-full text-[11px] sm:text-xs pb-1 sm:pb-2" id="wizard-steps">
  {stepTitles.map((title, idx) => (
    <li
      class:list={[
        "step",
        idx === 0 && "step-secondary font-bold",
        devMode && "cursor-pointer group",
      ]}
      data-step-indicator={idx}
      aria-label={`Paso ${idx + 1}: ${title}`}
    >
      <span class="hidden sm:inline transition-colors group-hover:text-secondary">{title}</span>
    </li>
  ))}
</ul>

<style>
  /* Fix daisyUI step line overlap by ensuring step badge circles stay strictly above connector lines */
  #wizard-steps .step::before {
    z-index: 0;
  }
  #wizard-steps .step::after,
  #wizard-steps .step > .step-icon {
    z-index: 2;
    position: relative;
  }
  #wizard-steps .step.cursor-pointer:hover::after {
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-secondary, #ff8400) 40%, transparent);
    transition: box-shadow 0.15s ease;
  }
  @media (max-width: 639px) {
    #wizard-steps {
      overflow: visible;
    }
    #wizard-steps .step {
      min-width: 0;
      grid-template-rows: 32px;
    }
    #wizard-steps .step::before {
      height: 0.375rem;
    }
    #wizard-steps .step::after {
      width: 1.75rem;
      height: 1.75rem;
      font-size: 0.75rem;
    }
  }
</style>
