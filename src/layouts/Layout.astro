---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  favicon?: string;
  showNav?: boolean;
  showFooter?: boolean;
}

const {
  title,
  favicon = "/images/logo-pum.png",
  showNav = true,
  showFooter = true,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="es" data-theme="pum" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Pastoral Universitaria de Mendoza</title>
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="preload" href="/fonts/pum-sans-bold.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/pum-display.woff" as="font" type="font/woff" crossorigin />
  </head>
  <body class="bg-base-100 text-base-content font-sans antialiased min-h-dvh flex flex-col selection:bg-secondary selection:text-secondary-content">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-secondary focus:text-secondary-content focus:rounded-lg focus:shadow-lg focus:outline-hidden"
    >
      Saltar al contenido principal
    </a>

    {showNav && <Navbar currentPath={currentPath} />}

    <main id="main-content" class="flex-1 flex flex-col">
      <slot />
    </main>

    {showFooter && <Footer />}
  </body>
</html>
